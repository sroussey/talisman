{
  "name": "@sroussey/talisman",
  "version": "1.0.0",
  "description": "Straightforward fuzzy matching, information retrieval and NLP building blocks for TypeScript & JavaScript.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "default": "./dist/helpers/index.js"
    },
    "./regexp": {
      "types": "./dist/regexp/index.d.ts",
      "default": "./dist/regexp/index.js"
    },
    "./inflectors/spanish": {
      "types": "./dist/inflectors/spanish/index.d.ts",
      "default": "./dist/inflectors/spanish/index.js"
    },
    "./tokenizers/fingerprint": {
      "types": "./dist/tokenizers/fingerprint/index.d.ts",
      "default": "./dist/tokenizers/fingerprint/index.js"
    },
    "./tokenizers/lines": {
      "types": "./dist/tokenizers/lines/index.d.ts",
      "default": "./dist/tokenizers/lines/index.js"
    },
    "./tokenizers/ngrams": {
      "types": "./dist/tokenizers/ngrams/index.d.ts",
      "default": "./dist/tokenizers/ngrams/index.js"
    },
    "./tokenizers/paragraphs": {
      "types": "./dist/tokenizers/paragraphs/index.d.ts",
      "default": "./dist/tokenizers/paragraphs/index.js"
    },
    "./tokenizers/sentences": {
      "types": "./dist/tokenizers/sentences/index.d.ts",
      "default": "./dist/tokenizers/sentences/index.js"
    },
    "./tokenizers/skipgrams": {
      "types": "./dist/tokenizers/skipgrams/index.d.ts",
      "default": "./dist/tokenizers/skipgrams/index.js"
    },
    "./tokenizers/words": {
      "types": "./dist/tokenizers/words/index.d.ts",
      "default": "./dist/tokenizers/words/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "BIBLIOGRAPHY.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bib": "bun run scripts/format-bibliography.ts > BIBLIOGRAPHY.md",
    "bench": "bun run benchmark/levenshtein.ts",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run check && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -p tsconfig.build.json --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sroussey/talisman.git"
  },
  "keywords": [
    "bloom filter",
    "canberra",
    "caverphone",
    "chebyshev",
    "cologne",
    "cosine",
    "clustering",
    "daitch-mokotoff",
    "dice",
    "fingerprint",
    "fuzzy",
    "hamming",
    "k-means",
    "jaccard",
    "jaro",
    "lancaster",
    "levenshtein",
    "lig",
    "metaphone",
    "mra",
    "natural language processing",
    "ngrams",
    "nlp",
    "nysiis",
    "phonetic",
    "porter",
    "punkt",
    "record linkage",
    "schinke",
    "sorensen",
    "soundex",
    "tokenizer",
    "typescript",
    "tversky",
    "winkler"
  ],
  "author": {
    "name": "Guillaume Plique",
    "url": "http://github.com/Yomguithereal"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sroussey/talisman/issues"
  },
  "homepage": "https://github.com/sroussey/talisman#readme",
  "dependencies": {
    "html-entities": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/seedrandom": "^3.0.8",
    "leven": "^4.1.0",
    "seedrandom": "^3.0.5",
    "typescript": "^5.9.3"
  }
}
